---
import { useTranslations, type TranslationKey } from "../i18n/translations";

export interface Props {
  position: string;
  positionKey?: string;
  company: string;
  period: string;
  periodKey?: string;
  alignment?: "top" | "bottom";
  description?: string[];
  descriptionKeys?: string[];
  /** Cada lista (móvil / escritorio) renderiza sólo su variante: antes cada entrada salía 4 veces. */
  variant: "mobile" | "desktop";
}

const {
  position,
  positionKey,
  company,
  period,
  periodKey,
  alignment = "top",
  description,
  descriptionKeys,
  variant,
} = Astro.props;

// El HTML del servidor sale con los mismos textos que pone setLang("es") al cargar.
const t = useTranslations("es");
const tx = (key: string | undefined, fallback: string) =>
  key ? t(key as TranslationKey) : fallback;
const positionText = tx(positionKey, position);
const periodText = tx(periodKey, period);
const items = (description ?? []).map((item, i) => tx(descriptionKeys?.[i], item));

// Clases para alineación horizontal (desktop/tablet)
const alignmentClasses =
  alignment === "top"
    ? "flex-col-reverse" // Contenido arriba, punto abajo
    : "flex-col"; // Punto arriba, contenido abajo

---

{
  variant === "mobile" && (
<!-- Versión móvil (< 768 px): riel a la izquierda, texto a ancho completo -->
<li class="relative md:hidden pl-8 mb-10">
  <!-- Punto sobre el riel (la línea está a left-[7px] en Experience.astro) -->
  <div
    class="absolute left-[1px] top-2 w-3.5 h-3.5 bg-shakespeare-400 rounded-full ring-4 ring-slate-900 z-10"
  >
  </div>

  <div class="text-left">
    <h3
      class="text-lg sm:text-xl font-semibold text-slate-100 mb-2"
      data-i18n={positionKey}
    >
      {positionText}
    </h3>
    <p class="text-base sm:text-lg font-semibold text-shakespeare-400 mb-1">
      {company}
    </p>

    {
      items.length > 0 && (
        <ul class="list-inside text-xs sm:text-sm text-slate-300 mt-2 mb-3 space-y-1">
          {items.map((item, index) => (
            <li class="leading-relaxed" data-i18n={descriptionKeys?.[index]}>
              {item}
            </li>
          ))}
        </ul>
      )
    }

    <div class="flex flex-wrap gap-2 mt-2">
      <span
        class="inline-block text-xs sm:text-sm px-3 py-1 bg-shakespeare-500/20 text-shakespeare-300 rounded-full border border-shakespeare-500/30"
        data-i18n={periodKey}>{periodText}</span
      >
    </div>
  </div>
</li>
  )
}

{
  variant === "desktop" && (
<!-- 💻 Versión tablet/desktop (timeline horizontal con scroll) -->
<!-- Solo visible en pantallas ≥ 768px -->
<li class="hidden md:flex relative flex-shrink-0 w-[300px] lg:w-[340px]">
  <div class={`flex ${alignmentClasses} items-center gap-8 lg:gap-12 h-full`}>
    <!-- Punto en la línea horizontal -->
    <div
      class="w-4 h-4 bg-shakespeare-400 rounded-full ring-4 ring-slate-900 z-10 flex-shrink-0"
    >
    </div>

    <!-- Card de contenido -->
    <div
      class="surface surface-hover p-4 lg:p-5 transition-all duration-300 hover:shadow-lg hover:shadow-shakespeare-500/10"
    >
      <h3
        class="text-base lg:text-lg font-semibold text-slate-100 mb-2"
        data-i18n={positionKey}
      >
        {positionText}
      </h3>
      <p class="text-sm lg:text-base font-semibold text-shakespeare-400 mb-1">
        {company}
      </p>
      {
        items.length > 0 && (
          <ul class="list-inside text-xs lg:text-sm text-slate-300 mt-2 space-y-1">
            {items.map((item, index) => (
              <li data-i18n={descriptionKeys?.[index]}>{item}</li>
            ))}
          </ul>
        )
      }

      <span
        class="inline-grid text-xs lg:text-sm px-3 py-1 mt-3 bg-shakespeare-500/20 text-shakespeare-300 rounded-full border border-shakespeare-500/30"
        data-i18n={periodKey}
      >
        {periodText}
      </span>
    </div>
  </div>
</li>
  )
}
