---
interface Props {
  class?: string;
  titleKey?: string;
  eyebrow?: string;
  eyebrowKey?: string;
}

const { class: className = "", titleKey, eyebrow, eyebrowKey } = Astro.props;
---

<div class={`flex flex-col items-center gap-3 text-center mb-10 sm:mb-14 md:mb-16 ${className}`}>
  {
    eyebrow && (
      <span
        class="font-mono text-xs text-shakespeare-400 uppercase tracking-[0.15em]"
        data-i18n={eyebrowKey}
      >
        {eyebrow}
      </span>
    )
  }
  <h2
    class="font-display text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-slate-100 text-balance"
    data-i18n={titleKey}
  >
    <slot />
  </h2>
</div>
