---
import Links from "../Links.astro";
import { Icon } from "astro-icon/components";
import { useTranslations } from "../../i18n/translations";

// El HTML del servidor sale con los mismos textos que pone setLang("es") al cargar.
const t = useTranslations("es");
---

<section
  id="sobre-mi"
  class="hero-fade-in min-h-screen flex items-center justify-center py-12 sm:py-16 md:py-20 lg:py-24 xl:py-28 px-4 sm:px-6 lg:px-8 relative z-10"
  aria-labelledby="hero-title"
>
  <div class="max-w-4xl mx-auto text-center">
    <div
      class="flex flex-col items-center justify-center space-y-4 sm:space-y-5 md:space-y-6"
    >
      <p
        class="text-sm sm:text-base text-slate-400 font-medium"
        data-i18n="hero.greeting"
      >{t("hero.greeting")}</p>

      <h1
        id="hero-title"
        class="font-display text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold tracking-tight text-slate-100"
      >
        Daybel Diaz
      </h1>

      <div
        class="flex flex-wrap items-center justify-center gap-2 text-xl sm:text-2xl md:text-3xl"
      >
        <span class="text-slate-400 font-medium">
          <span id="animated-role" class="text-shakespeare-400"
            >Desarrollador Java</span
          >
        </span>
        <span class="text-slate-100">&</span>
        <span class="text-slate-100 font-semibold" data-i18n="hero.role"
          >{t("hero.role")}</span>
      </div>

      <p class="text-sm sm:text-base text-slate-400 max-w-md pt-2">
        Spring Boot • PostgreSQL • Docker
      </p>

      <p
        class="text-sm sm:text-base md:text-lg text-slate-300 leading-relaxed max-w-2xl pt-4"
      >
        <span data-i18n="hero.experience">{t("hero.experience")}</span>
        <span data-i18n="hero.location">{t("hero.location")}</span>.
         <span data-i18n="hero.description"
          >{t("hero.description")}</span>
      </p>

      <div class="flex flex-wrap justify-center gap-3 sm:gap-4 pt-6 sm:pt-8">
        <Links
          name="GitHub"
          href="https://github.com/Syo0131"
          icon="simple-icons:github"
        />
        <Links
          name="LinkedIn"
          href="https://linkedin.com/in/DaybelDiaz/"
          icon="mdi:linkedin"
        />
        
        <div class="relative cv-dropdown" id="cv-dropdown-container">
          <button
            id="cv-menu-btn"
            class="group bg-shakespeare-800/80 hover:bg-shakespeare-700/80 backdrop-blur-sm transition-all duration-300 ease-smooth-out hover:scale-105 hover:shadow-lg hover:shadow-shakespeare-500/20 text-white font-semibold py-2.5 px-5 sm:px-7 rounded-full flex items-center gap-x-2.5 text-sm sm:text-base cursor-pointer"
            aria-controls="cv-menu"
            aria-expanded="false"
            type="button"
          >
            <Icon
              name="material-symbols:download"
              class="w-5 h-5 sm:w-6 sm:h-6 flex-shrink-0 transition-transform duration-300 ease-smooth-out group-hover:scale-110" aria-hidden="true" />
            <span data-i18n="hero.downloadCv">{t("hero.downloadCv")}</span>
            <Icon
              name="material-symbols:keyboard-arrow-down"
              class="w-5 h-5 transition-transform duration-300 group-aria-expanded:rotate-180" aria-hidden="true" />
          </button>
          
          <!-- pt-2 (no mt-2): el hueco forma parte del menú, así el puntero no sale del contenedor al bajar -->
          <div
            id="cv-menu"
            hidden
            class="absolute top-full pt-2 left-0 w-full min-w-max z-50"
          >
            <div class="bg-slate-800 rounded-xl overflow-hidden shadow-xl border border-slate-700">
            <a 
              href="/Daybel_Diaz_Cv_Java.pdf" 
              download="Daybel_Diaz_Cv_Java.pdf" 
              class="flex items-center gap-3 px-4 py-3 hover:bg-slate-700/50 hover:text-white text-slate-200 transition-colors"
            >
              <span class="text-shakespeare-400 font-bold tracking-wide text-sm flex-shrink-0">ES</span>
              <span class="text-sm font-medium">Español</span>
            </a>
            <a 
              href="/Daybel_Diaz_JavaAnalystDev.pdf" 
              download="Daybel_Diaz_JavaAnalystDev.pdf" 
              class="flex items-center gap-3 px-4 py-3 hover:bg-slate-700/50 hover:text-white text-slate-200 transition-colors border-t border-slate-700"
            >
              <span class="text-shakespeare-400 font-bold tracking-wide text-sm flex-shrink-0">EN</span>
              <span class="text-sm font-medium">English</span>
            </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { shouldCloseCvMenu } from "../../lib/ui";
  import { getLang, onLangChange } from "../../i18n/client";

  function initRoleAnimation() {
    const rolesES = [
      "Desarrollador Java",
      "Desarrollador Backend",
      "Desarrollador Spring Boot",
      "Desarrollador Full-Stack",
    ];

    const rolesEN = [
      "Java Developer",
      "Backend Developer",
      "Spring Boot Developer",
      "Full-Stack Developer",
    ];

    let currentIndex = 0;
    let currentLang = getLang();
    let isAnimating = false;
    let activeTimeouts: ReturnType<typeof setTimeout>[] = [];
    const roleElement = document.getElementById("animated-role");

    if (!roleElement || roleElement.dataset.bound === "true") return;
    roleElement.dataset.bound = "true";

    function getCurrentRoles() {
      return currentLang === "es" ? rolesES : rolesEN;
    }

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      roleElement.textContent = getCurrentRoles()[0];
      onLangChange((lang) => {
        currentLang = lang;
        roleElement.textContent = getCurrentRoles()[0];
      });
      return;
    }

    function clearAllTimeouts() {
      activeTimeouts.forEach((timeout) => clearTimeout(timeout));
      activeTimeouts = [];
    }

    function typeWriter(text: string, index: number, callback: () => void) {
      if (!roleElement || !isAnimating) return;
      if (index < text.length) {
        roleElement.textContent = text.substring(0, index + 1);
        const timeout = setTimeout(
          () => typeWriter(text, index + 1, callback),
          100,
        );
        activeTimeouts.push(timeout);
      } else {
        const timeout = setTimeout(callback, 2000);
        activeTimeouts.push(timeout);
      }
    }

    function eraseText(callback: () => void) {
      if (!roleElement || !isAnimating) return;
      const currentText = roleElement.textContent || "";
      if (currentText.length > 0) {
        roleElement.textContent = currentText.substring(
          0,
          currentText.length - 1,
        );
        const timeout = setTimeout(() => eraseText(callback), 50);
        activeTimeouts.push(timeout);
      } else {
        callback();
      }
    }

    function animateRole() {
      if (!roleElement || !isAnimating) return;

      const roles = getCurrentRoles();
      const currentRole = roles[currentIndex];
      typeWriter(currentRole, 0, () => {
        eraseText(() => {
          currentIndex = (currentIndex + 1) % roles.length;
          const timeout = setTimeout(animateRole, 500);
          activeTimeouts.push(timeout);
        });
      });
    }

    function startAnimation() {
      clearAllTimeouts();
      isAnimating = true;
      currentIndex = 0;
      if (roleElement) {
        roleElement.textContent = "";
      }
      animateRole();
    }

    function stopAnimation() {
      isAnimating = false;
      clearAllTimeouts();
      if (roleElement) {
        roleElement.textContent = "";
      }
    }

    onLangChange((newLang) => {
      currentLang = newLang;
      stopAnimation();
      setTimeout(startAnimation, 200);
    });

    // Iniciar animación
    startAnimation();
  }

  function initCvMenu() {
    const container = document.getElementById("cv-dropdown-container");
    const btn = document.getElementById("cv-menu-btn");
    const menu = document.getElementById("cv-menu");
    if (!container || !btn || !menu) return;
    if (btn.dataset.bound === "true") return;
    btn.dataset.bound = "true";

    function openMenu() {
      menu?.removeAttribute("hidden");
      btn?.setAttribute("aria-expanded", "true");
    }

    function closeMenu(restoreFocus = false) {
      if (!menu || menu.hasAttribute("hidden")) return;
      menu.setAttribute("hidden", "");
      btn?.setAttribute("aria-expanded", "false");
      openedByHover = false;
      if (restoreFocus) btn?.focus();
    }

    const hoverCapable = window.matchMedia("(hover: hover)").matches;
    // Si el menú se abrió por hover, el clic que viene después lo "fija" en vez de cerrarlo.
    let openedByHover = false;
    let closeTimer: ReturnType<typeof setTimeout> | undefined;

    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = btn.getAttribute("aria-expanded") === "true";
      if (isOpen && openedByHover) {
        openedByHover = false;
      } else if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") {
        closeMenu(true);
      }
    });

    document.addEventListener("click", (e) => {
      if (!container.contains(e.target as Node)) {
        closeMenu();
      }
    });

    // Teclado: al salir con Tab del botón o de los enlaces, el menú se cierra.
    container.addEventListener("focusout", (e) => {
      const next = (e as FocusEvent).relatedTarget as Node | null;
      // Regla en src/lib/ui.ts (con tests): en Safari relatedTarget llega null al hacer clic
      // en un enlace del menú, y en ese caso el puntero encima decide que no se cierre.
      if (shouldCloseCvMenu(next ? container.contains(next) : null, container.matches(":hover"))) {
        closeMenu();
      }
    });

    if (hoverCapable) {
      container.addEventListener("mouseenter", () => {
        clearTimeout(closeTimer);
        if (btn.getAttribute("aria-expanded") !== "true") {
          openedByHover = true;
          openMenu();
        }
      });
      container.addEventListener("mouseleave", () => {
        clearTimeout(closeTimer);
        closeTimer = setTimeout(() => {
          openedByHover = false;
          closeMenu();
        }, 150);
      });
    }
  }

  function initHero() {
    initRoleAnimation();
    initCvMenu();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHero);
  } else {
    initHero();
  }

</script>
<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-fade-in {
      animation: heroFadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  }

  @keyframes heroFadeIn {
    0% {
      opacity: 0.01;
      transform: translateY(20px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
