---
import ExperienceTimeline from "../ExperienceTimeline.astro";
import SectionTitle from "../SectionTitle.astro";
import type { Props as ExperienceProps } from "../ExperienceTimeline.astro";

const experiencias: ExperienceProps[] = [
  {
    position: "Product Manager & FullStack Developer",
    positionKey: "experience.freelance.position",
    company: "Freelance",
    period: "Marzo 2024 - Presente",
    periodKey: "experience.freelance.period",
    alignment: "top",
    alignmentMobile: "right",
    description: [
      "Desarrollo de aplicaciones web a medida para diversos clientes, gestionando el ciclo completo del producto y liderando un equipo de desarrollo.",
      "Implementación de soluciones full-stack, arquitecturas escalables y coordinación de equipos para asegurar alto rendimiento y calidad.",
    ],
    descriptionKeys: [
      "experience.freelance.desc1",
      "experience.freelance.desc2",
    ],
  },
  {
    position: "BackEnd & Infraestructure engineer",
    positionKey: "experience.pensum.position",
    company: "El Pensum",
    period: "Noviembre 2025 - Febrero 2026",
    periodKey: "experience.pensum.period",
    alignment: "bottom",
    alignmentMobile: "left",
    description: [
      "Responsable de la arquitectura integral del proyecto, enfocándome en la escalabilidad del backend y la eficiencia operativa de la infraestructura.",
      "Arquitecté el backend con Spring Boot, aplicando patrones de diseño para garantizar la mantenibilidad y el rendimiento con PostgreSQL",
    ],
    descriptionKeys: ["experience.pensum.desc1", "experience.pensum.desc2"],
  },
  {
    position: "Java Analyst Developer",
    positionKey: "experience.java.position",
    company: "IKEA Sarton ( BitBox Caribe SRL )",
    period: "Junio 2025 - Presente",
    periodKey: "experience.java.period",
    alignment: "top",
    alignmentMobile: "right",
    description: [
      "Desarrollo y mantenimiento de módulos Java para la gestión de usuarios y tarjetas de fidelidad.",
      "Implementación de funcionalidades para el procesamiento de facturas electrónicas y conciliación de transacciones.",
    ],
    descriptionKeys: ["experience.java.desc1", "experience.java.desc2"],
  },
  // {
  //   position: "Founder & Product Manager",
  //   positionKey: "experience.founder.position",
  //   company: "CommitCore",
  //   period: "Junio 2025 - Presente",
  //   periodKey: "experience.founder.period",
  //   alignment: "top",
  //   alignmentMobile: "right",
  //   description: [
  //     "Lideré el desarrollo de una plataforma de gestión de proyectos, desde la concepción hasta el lanzamiento, utilizando React para el frontend y Node.js para el backend.",
  //     "Gestioné un equipo multidisciplinario, coordinando tareas y asegurando la entrega oportuna de funcionalidades clave.",
  //   ],
  //   descriptionKeys: ["experience.founder.desc1", "experience.founder.desc2"],
  // },
];
---

<section
  id="experiencia"
  class="py-12 sm:py-16 md:py-24 px-4 sm:px-6 lg:px-8 animate-on-scroll"
>
  <div class="max-w-7xl mx-auto">
    <SectionTitle titleKey="experience.title">Experiencia Laboral</SectionTitle>

    <!-- 📱 Versión móvil: Timeline vertical -->
    <div class="md:hidden relative">
      <!-- Línea vertical central -->
      <div
        class="absolute left-1/2 -translate-x-1/2 top-0 h-full w-0.5 bg-shakespeare-800/30"
      >
      </div>

      <!-- Lista de experiencias móvil -->
      <ul class="relative space-y-0">
        {experiencias.map((exp) => <ExperienceTimeline {...exp} />)}
      </ul>
    </div>

    <!-- 💻 Versión tablet/desktop: Timeline horizontal con scroll -->
    <div class="hidden md:block relative">
      <!-- Contenedor de scroll -->
      <div
        id="scroll-container"
        class="overflow-x-auto pb-6"
        style="overflow-y: visible;"
      >
        <!-- Contenedor interno para extender la línea -->
        <div class="relative px-8 min-w-max">
          <!-- Línea horizontal continua -->
          <div
            class="absolute top-1/2 left-0 right-0 h-0.5 bg-shakespeare-800/30 -translate-y-1/2 w-full"
            style="z-index: 0;"
          >
          </div>

          <!-- Lista de experiencias desktop -->
          <ul
            class="relative flex items-center justify-center gap-12"
            style="z-index: 1;"
          >
            {experiencias.map((exp) => <ExperienceTimeline {...exp} />)}
          </ul>
        </div>
      </div>

      <!-- Indicador de scroll -->
      <div id="scroll-indicator" class="text-center mt-6 hidden">
        <p class="text-xs text-slate-500 animate-pulse">
          ← Desliza para ver más experiencias →
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Contenedor de scroll */
  #scroll-container {
    scroll-behavior: smooth;
    overflow-x: auto;
    /* Ocultar scrollbar estándar pero mantener funcionalidad de scroll */
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE y Edge antiguo */
  }

  /* Ocultar scrollbar en Chrome, Safari y Edge modernos */
  #scroll-container::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  // Detectar si hay scroll disponible y mostrar/ocultar el indicador
  function checkScroll() {
    const container = document.getElementById("scroll-container");
    const indicator = document.getElementById("scroll-indicator");

    if (container && indicator) {
      // Verificar si el contenido es más ancho que el contenedor
      const hasScroll = container.scrollWidth > container.clientWidth;

      if (hasScroll) {
        indicator.classList.remove("hidden");
        // Forzar que el contenedor tenga scroll visible
        container.style.overflowX = "auto";
        // Agregar un padding extra para asegurar espacio para la scrollbar
        container.style.paddingBottom = "1.5rem";
        // Añadir cursor para arrastrar
        container.style.cursor = "grab";
      } else {
        indicator.classList.add("hidden");
        container.style.overflowX = "hidden";
        container.style.paddingBottom = "1.5rem";
        // Quitar cursor para arrastrar
        container.style.cursor = "default";
      }
    }
  }

  // Ejecutar al cargar la página
  document.addEventListener("DOMContentLoaded", checkScroll);

  // Ejecutar al redimensionar la ventana
  window.addEventListener("resize", checkScroll);

  // Ejecutar después de que las fuentes y contenido se carguen completamente
  window.addEventListener("load", checkScroll);

  // Lógica para arrastrar y hacer scroll (Drag to scroll)
  const slider = document.getElementById("scroll-container");
  if (slider) {
    let isDown = false;
    let startX: number;
    let scrollLeft: number;

    slider.addEventListener("mousedown", (e) => {
      // Verificar si hay scroll disponible antes de permitir arrastrar
      if (slider.scrollWidth <= slider.clientWidth) return;

      isDown = true;
      slider.style.cursor = "grabbing";
      startX = e.pageX - slider.offsetLeft;
      scrollLeft = slider.scrollLeft;
      // Prevenir la selección de texto o arrastre de imágenes mientras se mueve
      slider.style.userSelect = "none";
    });

    slider.addEventListener("mouseleave", () => {
      if (!isDown) return;
      isDown = false;
      slider.style.cursor =
        slider.scrollWidth > slider.clientWidth ? "grab" : "default";
      slider.style.removeProperty("user-select");
    });

    slider.addEventListener("mouseup", () => {
      if (!isDown) return;
      isDown = false;
      slider.style.cursor =
        slider.scrollWidth > slider.clientWidth ? "grab" : "default";
      slider.style.removeProperty("user-select");
    });

    slider.addEventListener("mousemove", (e) => {
      if (!isDown) return;
      e.preventDefault(); // Previene comportamientos por defecto como seleccionar
      const x = e.pageX - slider.offsetLeft;
      const walk = (x - startX) * 1.5; // Multiplicador de velocidad de desplazamiento
      slider.scrollLeft = scrollLeft - walk;
    });
  }
</script>
