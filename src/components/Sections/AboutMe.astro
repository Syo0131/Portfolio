---
import SectionTitle from "../SectionTitle.astro";
---

<section
  id="aboutme"
  class="py-12 sm:py-16 md:py-20 lg:py-24 xl:py-28 px-4 sm:px-6 lg:px-8 animate-on-scroll"
>
  <div class="max-w-7xl mx-auto">
    <SectionTitle titleKey="nav.aboutme">Sobre Mí</SectionTitle>

    <!-- Intro Section -->
    <div class="mt-12 sm:mt-16 max-w-4xl">
      <h3
        class="text-3xl md:text-4xl lg:text-5xl font-bold text-slate-100 tracking-tight leading-tight mb-6"
      >
        <span data-i18n="aboutme.highlight">Más allá del código:</span>
        <span class="text-shakespeare-400" data-i18n="aboutme.scaling">
          compromiso
        </span>
        <span data-i18n="aboutme.robust">con la excelencia.</span>
      </h3>

      <div class="space-y-4 text-base sm:text-lg text-slate-400 leading-relaxed">
        <p data-i18n="aboutme.p1">
          Mi objetivo es construir software que no solo resuelva problemas,
          sino que sea un activo sólido para el futuro...
        </p>
        <p data-i18n="aboutme.p2">
          Disfruto colaborar en entornos que desafían mi lógica...
        </p>
      </div>
    </div>

    <!-- Features Grid -->
    <div class="mt-12 sm:mt-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Card 1: Experiencia -->
      <div class="group relative border border-slate-800 p-6 hover:border-shakespeare-400/50 transition-all">
        <div class="flex items-start justify-between mb-4">
          <div class="text-4xl font-bold text-shakespeare-400">3+</div>
          <svg class="w-6 h-6 text-slate-600 group-hover:text-shakespeare-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h4 class="text-sm uppercase tracking-wider text-slate-500 font-semibold">Años de Experiencia</h4>
        <p class="mt-2 text-sm text-slate-400">Desarrollo profesional</p>
      </div>

      <!-- Card 2: Proyectos -->
      <div class="group relative border border-slate-800 p-6 hover:border-shakespeare-400/50 transition-all">
        <div class="flex items-start justify-between mb-4">
          <div class="text-4xl font-bold text-shakespeare-400">15+</div>
          <svg class="w-6 h-6 text-slate-600 group-hover:text-shakespeare-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
        <h4 class="text-sm uppercase tracking-wider text-slate-500 font-semibold">Proyectos</h4>
        <p class="mt-2 text-sm text-slate-400">Completados con éxito</p>
      </div>

      <!-- Card 3: Tecnologías -->
      <div class="group relative border border-slate-800 p-6 hover:border-shakespeare-400/50 transition-all">
        <div class="flex items-start justify-between mb-4">
          <div class="text-4xl font-bold text-shakespeare-400">10+</div>
          <svg class="w-6 h-6 text-slate-600 group-hover:text-shakespeare-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
          </svg>
        </div>
        <h4 class="text-sm uppercase tracking-wider text-slate-500 font-semibold">Tecnologías</h4>
        <p class="mt-2 text-sm text-slate-400">Stack dominado</p>
      </div>

      <!-- Card 4: Aprendizaje -->
      <div class="group relative border border-slate-800 p-6 hover:border-shakespeare-400/50 transition-all">
        <div class="flex items-start justify-between mb-4">
          <div class="text-4xl font-bold text-shakespeare-400">∞</div>
          <svg class="w-6 h-6 text-slate-600 group-hover:text-shakespeare-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <h4 class="text-sm uppercase tracking-wider text-slate-500 font-semibold">Aprendizaje</h4>
        <p class="mt-2 text-sm text-slate-400">Crecimiento continuo</p>
      </div>
    </div>

    <!-- Bottom Section -->
    <div class="mt-12 sm:mt-16 grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
      <!-- Philosophy & Mindset -->
      <div>
        <h4
          class="text-xs uppercase tracking-[0.2em] text-slate-500 font-bold mb-6 pb-2 border-b border-slate-800"
          data-i18n="aboutme.label.philosophy"
        >
          Mentalidad
        </h4>
        <ul class="space-y-5">
          {
            ["aboutme.p_item1", "aboutme.p_item2", "aboutme.p_item3"].map(
              (key) => (
                <li class="flex items-start gap-4 group">
                  <div class="mt-1 flex-shrink-0">
                    <div class="w-6 h-6 border border-shakespeare-400 flex items-center justify-center group-hover:bg-shakespeare-400 transition-colors">
                      <svg class="w-3 h-3 text-shakespeare-400 group-hover:text-black transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                      </svg>
                    </div>
                  </div>
                  <span class="text-slate-300 leading-relaxed flex-1" data-i18n={key}>Texto</span>
                </li>
              ),
            )
          }
        </ul>
      </div>

      <!-- Tech Stack & CTA -->
      <div class="space-y-8">
        <div>
          <h4 class="text-xs uppercase tracking-[0.2em] text-slate-500 font-bold mb-6 pb-2 border-b border-slate-800">
            Stack Principal
          </h4>
          <div class="grid grid-cols-2 gap-3">
            {["Java", "Spring Boot", "PostgreSQL", "Angular", "Docker", "Git"].map((tech) => (
              <div class="flex items-center gap-2 text-slate-300">
                <div class="w-1.5 h-1.5 bg-shakespeare-400"></div>
                <span class="text-sm font-medium">{tech}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- CTA -->
        <div class="pt-4">
          <a
            href="#contacto"
            class="inline-block border-2 border-shakespeare-400 px-6 py-3 text-shakespeare-400 font-bold hover:bg-shakespeare-400 hover:text-black transition-all"
          >
            <span data-i18n="aboutme.contact_me">Hablemos del proyecto</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
