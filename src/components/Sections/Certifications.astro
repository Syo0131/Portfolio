---
import CertificationsBadge from "../CertificationsBadge.astro";
import SectionTitle from "../SectionTitle.astro";

const certification = [
  {
    title: "Spring Framework 6 & Spring Boot 3 desde cero a experto",
    titleKey: "certifications.spring.title",
    issuer: "Udemy",
    date: "Octubre 2025",
    dateKey: "certifications.spring.date",
    sortDate: "2025-10",
    teacher: "Andrés Guzmán",
    link: "https://udemy-certificate.s3.amazonaws.com/image/UC-9ab6ccbc-2fb0-4647-9ec7-514aa80407a0.jpg",
    icon: "simple-icons:spring",
  },
  {
    title: "Java avanzado: reactividad, concurrencia y patrones",
    titleKey: "certifications.java.title",
    issuer: "Devtalles",
    date: "Cursando",
    dateKey: "certifications.java.date",
    sortDate: "9999-99",
    teacher: "Gabriel Chaldú",
    icon: "fontisto:java",
  },
  {
    title: "Spring Boot with Spring Framework",
    titleKey: "certifications.springframework.title",
    issuer: "Udemy",
    date: "Enero 2026",
    dateKey: "certifications.springframework.date",
    sortDate: "2026-01",
    teacher: "Gauttam SK",
    icon: "simple-icons:spring",
    link: "https://udemy-certificate.s3.amazonaws.com/image/UC-064f57fb-40eb-4513-8a90-675334e51d74.jpg",
  },
  {
    title: "Desarrollo Web Full Stack - Nivel Intermedio",
    titleKey: "certifications.fullstack.title",
    issuer: "INDOTEL / Cymetria",
    date: "Enero 2026",
    dateKey: "certifications.fullstack.date",
    sortDate: "2026-01",
    teacher: "INDOTEL",
    icon: "mdi:web",
    link: "https://drive.google.com/file/d/1JldTyGnOApBhZzxsEHgXwU6daP8S-kel/view?usp=sharing",
  },
  {
    title: "Introducción a la programación con C#",
    titleKey: "certifications.csharp.title",
    issuer: "Udemy",
    date: "Diciembre 2025",
    dateKey: "certifications.csharp.date",
    sortDate: "2025-12",
    teacher: "Juan Restituyo",
    icon: "devicon-plain:csharp",
    link: "https://udemy-certificate.s3.amazonaws.com/image/UC-2aa988ce-56bf-42a6-9d72-5304fc064cbb.jpg",
  },
  {
    title: "Enterprise full stack with Spring Boot 4 and Angular 21",
    titleKey: "certifications.enterprise.title",
    issuer: "Dev Senior Code",
    date: "Marzo 2026",
    dateKey: "certifications.enterprise.date",
    sortDate: "2026-03",
    teacher: "Cesar Díaz",
    icon: "simple-icons:spring",
    link: "https://drive.google.com/file/d/17WvCzGNkNEg6PDl90C71273tWePrMfOa/view?usp=sharing",
  },
  {
    title: "Principios SOLID y Clean Code",
    titleKey: "certifications.solid.title",
    issuer: "Devtalles",
    date: "Enero 2026",
    dateKey: "certifications.solid.date",
    sortDate: "2026-01",
    teacher: "Fernando Herrera",
    icon: "mdi:cube-outline",
    link: "https://cursos.devtalles.com/certificates/o675hwwzxh",
  },
  {
    title: "Introduccion a SQL",
    titleKey: "certifications.sql.title",
    issuer: "DataCamp",
    date: "Febrero 2026",
    dateKey: "certifications.sql.date",
    sortDate: "2026-02",
    icon: "mdi:sql-query",
    link: "https://drive.google.com/file/d/1vGfaEqhuGc5f-BnSpJgF5zRQz8_2viX-/view?usp=sharing&usp=embed_facebook",
  },
].sort((a, b) => b.sortDate.localeCompare(a.sortDate));

const VISIBLE = 6;
---

<section id="certifications" class="animate-on-scroll">
  <div class="py-12 sm:py-16 md:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <SectionTitle class="mb-8 sm:mb-12 md:mb-16" titleKey="certifications.title"
      >Certificaciones</SectionTitle
    >

    <div
      id="certifications-grid"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8"
    >
      {
        certification.map(({ sortDate, ...cert }, index) => (
          <div
            class="flex justify-center cert-item"
            data-cert-extra={index >= VISIBLE ? "" : undefined}
            hidden={index >= VISIBLE}
          >
            <CertificationsBadge {...cert} />
          </div>
        ))
      }
    </div>

    {
      certification.length > VISIBLE && (
        <div class="flex justify-center mt-8 sm:mt-12">
          <button
            id="certs-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="certifications-grid"
            class="group bg-shakespeare-500/20 hover:bg-shakespeare-500/30 transition-all duration-300 ease-smooth-out hover:scale-105 hover:shadow-lg hover:shadow-shakespeare-500/20 text-shakespeare-300 hover:text-shakespeare-200 font-semibold py-3 px-6 sm:px-8 rounded-full flex items-center gap-x-3 text-sm sm:text-base border border-shakespeare-500/30 hover:border-shakespeare-500/50"
          >
            <span id="certs-toggle-text" data-i18n="certifications.showAll">Ver todas</span>
            <svg
              class="certs-toggle-icon w-5 h-5 sm:w-6 sm:h-6 flex-shrink-0 transition-transform duration-300"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
            </svg>
          </button>
        </div>
      )
    }
  </div>
</section>

<script>
  import { t } from "../../i18n/client";

  function initCertsToggle() {
    const btn = document.getElementById("certs-toggle");
    const text = document.getElementById("certs-toggle-text");
    if (!btn || !text || btn.dataset.bound === "true") return;
    btn.dataset.bound = "true";

    btn.addEventListener("click", () => {
      const expanded = btn.getAttribute("aria-expanded") === "true";
      document
        .querySelectorAll<HTMLElement>("[data-cert-extra]")
        .forEach((el) => (el.hidden = expanded));
      btn.setAttribute("aria-expanded", String(!expanded));
      const key = expanded ? "certifications.showAll" : "certifications.showLess";
      text.setAttribute("data-i18n", key);
      text.textContent = t(key);
      btn.querySelector(".certs-toggle-icon")?.classList.toggle("rotate-180", !expanded);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCertsToggle);
  } else {
    initCertsToggle();
  }
</script>
