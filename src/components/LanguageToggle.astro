---
import { Icon } from "astro-icon/components";
---

<button
  class="lang-toggle group relative flex items-center justify-center size-10 lg:size-12 rounded-full bg-slate-900/80 backdrop-blur-lg text-slate-100 hover:text-white transition-all duration-300 ease-out hover:scale-110 ring-1 ring-white/20 hover:ring-shakespeare-400/60 hover:bg-shakespeare-900/30 hover:shadow-[0_0_15px_rgba(74,144,226,0.3)] active:scale-95 overflow-hidden"
  aria-label="Cambiar idioma"
  data-i18n-aria="a11y.toggleLanguage"
  title="Cambiar idioma / Change language"
  type="button"
>
  <!-- Icono decorativo de fondo (Watermark) -->
  <Icon
    name="mdi:web"
    class="absolute -right-1.5 -bottom-1.5 size-7 text-shakespeare-400/20 transition-all duration-500 group-hover:-rotate-12 group-hover:scale-125 group-hover:text-shakespeare-300/30" aria-hidden="true" />

  <!-- Texto del idioma centrado -->
  <span
    class="lang-text relative z-10 text-sm font-bold tracking-wider drop-shadow-md transition-all duration-300 uppercase"
    >ES</span
  >
</button>

<script>
  import { getLang, setLang } from "../i18n/client";

  function initLanguageToggle() {
    const toggles = document.querySelectorAll<HTMLButtonElement>(".lang-toggle");

    toggles.forEach((btn) => {
      if (btn.dataset.bound === "true") return;
      btn.dataset.bound = "true";
      btn.addEventListener("click", () => {
        const nextLang = getLang() === "es" ? "en" : "es";
        setLang(nextLang);
      });
    });

    setLang(getLang());
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initLanguageToggle);
  } else {
    initLanguageToggle();
  }

  document.addEventListener("astro:page-load", initLanguageToggle);
</script>
