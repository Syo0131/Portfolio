---
import { Icon } from "astro-icon/components";
import { getImage } from "astro:assets";
import { useTranslations } from "../i18n/translations";
import type { Project } from "../data/projects";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const t = useTranslations("es");

// URLs webp optimizadas para la galería, por proyecto.
const galleryEntries = await Promise.all(
  projects.map(async (p) => {
    const imgs = await Promise.all(
      p.images.map(async (img) => ({
        src: (await getImage({ src: img.src, format: "webp", width: 1600 })).src,
        alt: img.alt,
      })),
    );
    return [p.id, imgs] as const;
  }),
);
const galleryData = JSON.stringify(Object.fromEntries(galleryEntries));
---

<script type="application/json" id="project-gallery-data" set:html={galleryData} />

<!-- Galería de imágenes -->
<dialog
  id="project-gallery"
  class="project-dialog m-auto h-full max-h-full w-full max-w-full bg-transparent p-0 backdrop:bg-slate-950/90"
  aria-labelledby="project-gallery-title"
>
  <div class="relative flex h-full w-full flex-col items-center justify-center gap-4 p-4 sm:p-10">
    <div class="flex w-full max-w-6xl items-center justify-between gap-4">
      <p id="project-gallery-title" class="truncate text-sm font-semibold text-slate-200"></p>
      <div class="flex items-center gap-3">
        <span id="project-gallery-count" class="font-mono text-xs text-slate-400"></span>
        <button
          type="button"
          class="dialog-close inline-flex items-center gap-1.5 rounded-xl border border-white/10 bg-slate-900/80 px-3 py-2 text-xs font-semibold text-slate-200 transition-colors hover:border-shakespeare-400/50 hover:text-white"
        >
          <Icon name="mdi:close" class="size-4" aria-hidden="true" />
          <span data-i18n="projects.close">{t("projects.close")}</span>
        </button>
      </div>
    </div>

    <div class="relative flex w-full max-w-6xl flex-1 items-center justify-center overflow-hidden">
      <img
        id="project-gallery-img"
        class="max-h-[75vh] max-w-full rounded-xl object-contain shadow-2xl transition-opacity duration-300"
        src=""
        alt=""
        decoding="async"
      />
      <button
        type="button"
        id="project-gallery-prev"
        class="gallery-nav absolute left-0 top-1/2 -translate-y-1/2 rounded-full border border-white/10 bg-slate-950/70 p-2 text-white transition-colors hover:text-shakespeare-300 sm:p-3"
        aria-label={t("projects.prevImage")}
        data-i18n-aria="projects.prevImage"
      >
        <Icon name="mdi:chevron-left" class="size-7" aria-hidden="true" />
      </button>
      <button
        type="button"
        id="project-gallery-next"
        class="gallery-nav absolute right-0 top-1/2 -translate-y-1/2 rounded-full border border-white/10 bg-slate-950/70 p-2 text-white transition-colors hover:text-shakespeare-300 sm:p-3"
        aria-label={t("projects.nextImage")}
        data-i18n-aria="projects.nextImage"
      >
        <Icon name="mdi:chevron-right" class="size-7" aria-hidden="true" />
      </button>
    </div>
  </div>
</dialog>

<!-- Detalle del proyecto -->
<dialog
  id="project-details"
  class="project-dialog m-auto max-h-[90vh] w-[calc(100%-2rem)] max-w-2xl overflow-hidden rounded-2xl border border-slate-800 bg-slate-950 p-0 text-slate-200 backdrop:bg-slate-950/70"
>
  {
    projects.map((p) => (
      <section data-project-id={p.id} hidden class="flex max-h-[90vh] flex-col">
        <header class="flex items-start justify-between gap-4 border-b border-slate-800 px-6 py-5">
          <div>
            <span
              class="font-mono text-[11px] uppercase tracking-[0.15em] text-shakespeare-400"
              data-i18n={p.categoryKey}
            >
              {t(p.categoryKey)}
            </span>
            <h3 class="mt-1 font-display text-2xl font-bold text-slate-100">{p.name}</h3>
          </div>
          <button
            type="button"
            class="dialog-close inline-flex items-center gap-1.5 rounded-xl border border-slate-800 px-3 py-2 text-xs font-semibold text-slate-300 transition-colors hover:border-shakespeare-400/50 hover:text-white"
          >
            <Icon name="mdi:close" class="size-4" aria-hidden="true" />
            <span data-i18n="projects.close">{t("projects.close")}</span>
          </button>
        </header>

        <div class="scrollbar-themed flex flex-col gap-6 overflow-y-auto px-6 py-6">
          <p class="text-sm leading-relaxed text-slate-300" data-i18n={p.descriptionKey}>
            {t(p.descriptionKey)}
          </p>

          <div>
            <p
              class="mb-3 font-mono text-[10px] uppercase tracking-[0.12em] text-slate-500"
              data-i18n="projects.stack"
            >
              {t("projects.stack")}
            </p>
            <ul class="flex flex-wrap gap-2">
              {p.stackFull.map((tech) => (
                <li class="rounded-lg border border-slate-800 bg-slate-900 px-3 py-1.5 text-xs text-slate-300">
                  {tech}
                </li>
              ))}
            </ul>
          </div>

          <div class="flex flex-wrap gap-3">
            <button
              type="button"
              class="open-gallery inline-flex items-center gap-2 rounded-xl border border-slate-700 px-4 py-2.5 text-sm font-semibold text-slate-200 transition-colors hover:border-shakespeare-500/60 hover:text-shakespeare-300"
              data-project-id={p.id}
            >
              <Icon name="mdi:image-multiple-outline" class="size-4" aria-hidden="true" />
              <span data-i18n="projects.viewImages">{t("projects.viewImages")}</span>
            </button>
            {p.urlDemo && (
              <a
                href={p.urlDemo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-xl bg-shakespeare-500 px-4 py-2.5 text-sm font-bold text-slate-950 transition-colors hover:bg-shakespeare-400"
              >
                <span data-i18n="projects.viewLive">{t("projects.viewLive")}</span>
                <Icon name="mdi:arrow-top-right" class="size-4" aria-hidden="true" />
              </a>
            )}
            {p.urlGit && (
              <a
                href={p.urlGit}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-xl border border-slate-700 px-4 py-2.5 text-sm font-semibold text-slate-200 transition-colors hover:border-shakespeare-500/60 hover:text-shakespeare-300"
              >
                <Icon name="mdi:github" class="size-4" aria-hidden="true" />
                <span data-i18n="projects.code">{t("projects.code")}</span>
              </a>
            )}
          </div>
        </div>
      </section>
    ))
  }
</dialog>

<script>
  type GalleryImage = { src: string; alt: string };

  function initProjectDialogs() {
    const gallery = document.getElementById("project-gallery") as HTMLDialogElement | null;
    const details = document.getElementById("project-details") as HTMLDialogElement | null;
    const dataEl = document.getElementById("project-gallery-data");
    if (!gallery || !details || !dataEl || gallery.dataset.bound === "true") return;
    gallery.dataset.bound = "true";

    const data = JSON.parse(dataEl.textContent || "{}") as Record<string, GalleryImage[]>;
    const img = document.getElementById("project-gallery-img") as HTMLImageElement;
    const title = document.getElementById("project-gallery-title")!;
    const count = document.getElementById("project-gallery-count")!;
    const prev = document.getElementById("project-gallery-prev")!;
    const next = document.getElementById("project-gallery-next")!;

    let images: GalleryImage[] = [];
    let current = 0;

    const show = (i: number) => {
      current = (i + images.length) % images.length;
      const item = images[current];
      img.src = item.src;
      img.alt = item.alt;
      count.textContent = `${current + 1} / ${images.length}`;
    };

    const openGallery = (id: string) => {
      images = data[id] ?? [];
      if (images.length === 0) return;
      const name = document.querySelector(`.project-case[data-project-id="${id}"] h3`);
      title.textContent = name?.textContent?.trim() ?? "";
      const multi = images.length > 1;
      prev.hidden = !multi;
      next.hidden = !multi;
      count.hidden = !multi;
      show(0);
      if (details.open) details.close();
      gallery.showModal();
    };

    const openDetails = (id: string) => {
      details.querySelectorAll<HTMLElement>("section[data-project-id]").forEach((s) => {
        s.hidden = s.dataset.projectId !== id;
      });
      details.showModal();
    };

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const galleryBtn = target.closest<HTMLElement>(".open-gallery");
      if (galleryBtn?.dataset.projectId) return openGallery(galleryBtn.dataset.projectId);
      const detailsBtn = target.closest<HTMLElement>(".open-details");
      if (detailsBtn?.dataset.projectId) return openDetails(detailsBtn.dataset.projectId);
    });

    prev.addEventListener("click", () => show(current - 1));
    next.addEventListener("click", () => show(current + 1));

    gallery.addEventListener("keydown", (e) => {
      if (images.length < 2) return;
      if (e.key === "ArrowLeft") show(current - 1);
      if (e.key === "ArrowRight") show(current + 1);
    });

    [gallery, details].forEach((dialog) => {
      dialog.querySelectorAll(".dialog-close").forEach((btn) =>
        btn.addEventListener("click", () => dialog.close()),
      );
      // Clic en el fondo (fuera del contenido) cierra.
      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) dialog.close();
      });
    });

    // En la galería, el contenedor ocupa toda la pantalla: cerrar también al clicar su fondo.
    gallery.firstElementChild?.addEventListener("click", (e) => {
      if (e.target === e.currentTarget) gallery.close();
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initProjectDialogs);
  } else {
    initProjectDialogs();
  }
</script>

<style is:global>
  html:has(dialog.project-dialog[open]) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .project-dialog[open] {
      animation: project-dialog-in 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .project-dialog[open]::backdrop {
      animation: project-backdrop-in 0.3s ease-out;
    }
  }

  @keyframes project-dialog-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.98);
    }
  }
  @keyframes project-backdrop-in {
    from {
      opacity: 0;
    }
  }
</style>
