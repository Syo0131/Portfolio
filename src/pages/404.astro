---
import Layout from "../layouts/Layout.astro";
import LanguageToggle from "../components/LanguageToggle.astro";
import { useTranslations } from "../i18n/translations";

const t = useTranslations("es");
---

<Layout title="Página no encontrada - Daybel Diaz">
  <div class="fixed top-5 right-4 z-[60]">
    <LanguageToggle />
  </div>
  <section class="min-h-[70vh] flex flex-col items-center justify-center text-center px-4 py-20">
    <h1 class="text-6xl sm:text-8xl font-bold text-shakespeare-400 mb-4">404</h1>
    <h2 class="text-2xl sm:text-3xl font-semibold text-slate-100 mb-4" data-i18n="notFound.title">
      {t("notFound.title")}
    </h2>
    <p class="text-slate-400 max-w-md mb-8" data-i18n="notFound.text">
      {t("notFound.text")}
    </p>
    <a
      href="/"
      class="inline-flex items-center px-6 py-3 rounded-full bg-shakespeare-600 hover:bg-shakespeare-500 text-white font-medium transition-colors duration-300"
    >
      <span data-i18n="notFound.back">{t("notFound.back")}</span>
    </a>
  </section>
</Layout>
