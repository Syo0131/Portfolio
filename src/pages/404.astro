---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Página no encontrada - Daybel Diaz">
  <section class="min-h-[70vh] flex flex-col items-center justify-center text-center px-4 py-20">
    <h1 class="text-6xl sm:text-8xl font-bold text-shakespeare-400 mb-4">404</h1>
    <h2 class="text-2xl sm:text-3xl font-semibold text-slate-100 mb-4">
      Página no encontrada
    </h2>
    <p class="text-slate-400 max-w-md mb-8">
      Lo sentimos, la página que buscas no existe o ha sido movida.
    </p>
    <a
      href="/"
      class="inline-flex items-center px-6 py-3 rounded-full bg-shakespeare-600 hover:bg-shakespeare-500 text-white font-medium transition-colors duration-300"
    >
      Volver al inicio
    </a>
  </section>
</Layout>
